                altAccum = 0
                AltTimerLabel.Visible = true
                AltUpdateLabel()
            elseif not v then
                altVisible = false
                altRunning = false
                AltTimerLabel.Visible = false
            end
        end
    })

    TimerTab:CreateKeybind({
        Name = L.AltTimerResetKey,
        CurrentKeybind = "RightAlt",
        HoldToInteract = false,
        Flag = "AltTimerResetKey",
        Callback = function(Keybind)
            local ok, key = pcall(function() return Enum.KeyCode[Keybind] end)
            if ok and key then getgenv().PanteliiiConfig.AltTimerResetKey = key end
        end
    })

    table.insert(Connections, UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe or UserInputService:GetFocusedTextBox() then return end

        if input.KeyCode == getgenv().PanteliiiConfig.MasterKeycode and input.KeyCode ~= Enum.KeyCode.Unknown then
            local newState = not getgenv().PanteliiiConfig.AimEnabled
            getgenv().PanteliiiConfig.AimEnabled = newState
            getgenv().PanteliiiConfig.FovVisible = newState

            if AimToggle and AimToggle.Set then AimToggle:Set(newState) end
            if FovToggle and FovToggle.Set then FovToggle:Set(newState) end
        end

        if input.KeyCode == getgenv().PanteliiiConfig.FlyKey and input.KeyCode ~= Enum.KeyCode.Unknown then
            local newState = not getgenv().PanteliiiConfig.FlyBypassEnabled
            ToggleBypassFly(newState)
            if FlyToggle and FlyToggle.Set then FlyToggle:Set(newState) end
        end

        if input.KeyCode == getgenv().PanteliiiConfig.ClickTpKey and input.KeyCode ~= Enum.KeyCode.Unknown and getgenv().PanteliiiConfig.ClickTpEnabled then
            if Mouse.Target then
                TeleportTo(Mouse.Hit.Position)
            end
        end
    end))

    -- ================== ОПТИМИЗИРОВАННЫЙ ЦИКЛ ==================
    -- Быстрая часть (каждый кадр): FOV + Аим
    -- Медленная часть (EspUpdateRate): ESP, Noclip, Speed, Car Speed
    local slowAccum = 0

    RenderConnection = RunService.RenderStepped:Connect(function(dt)
        local cfg = getgenv().PanteliiiConfig
        local localChar = LocalPlayer.Character
        local localHrp = localChar and localChar:FindFirstChild("HumanoidRootPart")
        local viewportSize = Camera.ViewportSize
        local viewportCenter = Vector2_new(viewportSize.X * 0.5, viewportSize.Y * 0.5)

        -- === БЫСТРАЯ ЧАСТЬ: FOV + AIM ===
        if cfg.FovVisible then
            FOVCircle.Position = viewportCenter
            FOVCircle.Radius = cfg.FovRadius
            FOVCircle.Visible = true
        else
            FOVCircle.Visible = false
        end

        local bestTargetPart = nil
        local bestTargetPredPos = nil
        local bestScreenPoint = nil
        local shortestFovDistance = math_huge

        for player, data in pairs(ESP_Cache) do
            if IsAlive(data.Char, data.Hum) then
                local isEnemy = CheckIsEnemy(player)
                local rootPart = data.Root

                if (cfg.AimEnabled or cfg.FovVisible) and isEnemy and localHrp and rootPart then
                    local dist3D = (localHrp.Position - rootPart.Position).Magnitude
                    if dist3D <= cfg.EspMaxDistance then
                        local targetPart = GetSelectedPart(data)
                        if targetPart then
                            local predPos = CalculatePredictedPosition(targetPart)
                            local worldPoint, onScreen = Camera:WorldToViewportPoint(predPos)

                            if onScreen then
                                local screenPos = Vector2_new(worldPoint.X, worldPoint.Y)
                                local distToCenter = (screenPos - viewportCenter).Magnitude

                                if distToCenter <= cfg.FovRadius and distToCenter < shortestFovDistance then
                                    shortestFovDistance = distToCenter
                                    bestTargetPart = targetPart
                                    bestTargetPredPos = predPos
                                    bestScreenPoint = screenPos
                                end
                            end
                        end
                    end
                end
            end
        end

        CurrentTargetPart = bestTargetPart
        CurrentTargetPredPos = bestTargetPredPos

        if cfg.AimEnabled and bestScreenPoint and mousemoverel then
            local mouseDelta = bestScreenPoint - viewportCenter
            if (mouseDelta.X * mouseDelta.X + mouseDelta.Y * mouseDelta.Y) > 2.25 then
                mousemoverel(mouseDelta.X * cfg.AimSmoothness, mouseDelta.Y * cfg.AimSmoothness)
            end
        end

        -- === МЕДЛЕННАЯ ЧАСТЬ ===
        slowAccum = slowAccum + dt
        if slowAccum < cfg.EspUpdateRate then return end
        slowAccum = 0

        if cfg.NoclipEnabled and localChar then
            for _, part in ipairs(localChar:GetChildren()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end

        if cfg.SpeedEnabled and localChar and localHrp then
            local humanoid = localChar:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.MoveDirection.Magnitude > 0 then
                local moveDir = humanoid.MoveDirection
                localHrp.AssemblyLinearVelocity = Vector3_new(moveDir.X * cfg.SpeedValue, localHrp.AssemblyLinearVelocity.Y, moveDir.Z * cfg.SpeedValue)
            end
        end

        if cfg.VehicleSpeedEnabled and localChar then
            local humanoid = localChar:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.SeatPart then
                local seat = humanoid.SeatPart
                local model = seat:FindFirstAncestorOfClass("Model")
                local targetPart = model and model.PrimaryPart or seat
                if seat:IsA("VehicleSeat") then seat.MaxSpeed = 9999 seat.Torque = 9999 end

                local isMovingForward = UserInputService:IsKeyDown(Enum.KeyCode.W) or (seat:IsA("VehicleSeat") and seat.Throttle > 0)
                if isMovingForward and targetPart then
                    local forwardVector = targetPart.CFrame.LookVector
                    targetPart.AssemblyLinearVelocity = Vector3_new(forwardVector.X * cfg.VehicleSpeedMult, targetPart.AssemblyLinearVelocity.Y, forwardVector.Z * cfg.VehicleSpeedMult)
                end
            end
        end

        for player, data in pairs(ESP_Cache) do
            if IsAlive(data.Char, data.Hum) then
                local isEnemy = CheckIsEnemy(player)
                local rootPart = data.Root
                local dist3D = (localHrp and rootPart) and (localHrp.Position - rootPart.Position).Magnitude or math_huge

                -- Обновляем звёзды раз в 0.5 сек
                if tick() - (data.LastStarsTick or 0) > 0.5 then
                    data.LastStars = GetStars(player)
                    data.LastStarsTick = tick()
                end

                if cfg.EspEnabled and isEnemy and rootPart and dist3D <= cfg.EspMaxDistance then
                    if not data.Highlight.Enabled then data.Highlight.Enabled = true end

                    if data.LastColor ~= cfg.BoxColor then
                        data.Highlight.FillColor = cfg.BoxColor
                        data.Highlight.OutlineColor = cfg.BoxColor
                        data.Label.TextColor3 = cfg.BoxColor
                        data.LastColor = cfg.BoxColor
                    end

                    local _, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
                    if onScreen then
                        if not data.Gui.Enabled then data.Gui.Enabled = true end

                        local factionText = cfg.ShowFactions and ("\n[" .. GetPlayerFaction(player) .. "]") or ""
                        local starsText = ""
                        if cfg.ShowStars and data.LastStars and data.LastStars > 0 then
                            starsText = "\n" .. string.rep("★", data.LastStars)
                        end
                        local fullText = (player.DisplayName or player.Name) .. factionText .. starsText

                        if data.LastText ~= fullText then
                            data.Label.Text = fullText
                            data.LastText = fullText
                        end
                    else
                        if data.Gui.Enabled then data.Gui.Enabled = false end
                    end
                else
                    if data.Highlight.Enabled then data.Highlight.Enabled = false end
                    if data.Gui.Enabled then data.Gui.Enabled = false end
                end
            else
                if data.Highlight.Enabled then data.Highlight.Enabled = false end
                if data.Gui.Enabled then data.Gui.Enabled = false end
            end
        end
    end)
end

