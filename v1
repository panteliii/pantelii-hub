    -- ==========================================

    local function IsAlive(char, hum)
        if not char then return false end
        hum = hum or char:FindFirstChildOfClass("Humanoid")
        return hum and hum.Health > 0 and hum:GetState() ~= Enum.HumanoidStateType.Dead
    end

    -- ============ ФРАКЦИИ (через player.Team) ============
    local function GetPlayerFaction(player)
        if not player then return "None" end
        if player.Team and player.Team.Name then return player.Team.Name end
        return "None"
    end

    local function IsCivilian(player)
        if not player or not player.Team then return false end
        return player.Team.Name == "Civilian"
    end

    local function CheckIsEnemy(player)
        if not player or player == LocalPlayer then return false end
        if not getgenv().PanteliiiConfig.TeamCheck then return true end

        local meCiv = IsCivilian(LocalPlayer)
        local tgtCiv = IsCivilian(player)

        if meCiv then
            return not tgtCiv
        end
        return tgtCiv
    end
    -- ======================================================

    -- ============ ЗВЁЗДЫ ============
    local function GetStars(player)
        local char = player.Character
        if not char then return 0 end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return 0 end

        local ng = hrp:FindFirstChild("NametagGui")
        if not ng then return 0 end

        local ws = ng:FindFirstChild("WantedStars")
        if not ws then return 0 end

        local count = 0
        for _, c in ipairs(ws:GetChildren()) do
            if c:IsA("ImageLabel") and c.Visible then
                count = count + 1
            end
        end
        return count
    end
    -- ================================

    local function IsVisibleFast(part, character)
        if not getgenv().PanteliiiConfig.WallCheck then return true end
        if not part or not part.Parent then return false end

        local origin = Camera.CFrame.Position
        local targetPos = part.Position

        table_clear(IgnoreTable)
        IgnoreTable[1] = Camera
        if LocalPlayer.Character then IgnoreTable[2] = LocalPlayer.Character end
        if character then IgnoreTable[3] = character end

        StaticRayParams.FilterDescendantsInstances = IgnoreTable
        local result = Workspace:Raycast(origin, targetPos - origin, StaticRayParams)
        if not result then return true end

        local hit = result.Instance
        return hit:IsDescendantOf(character) or hit.CanCollide == false or hit.Transparency >= 0.75 or hit:IsA("Seat") or hit:IsA("VehicleSeat")
    end

    local function GetSelectedPart(data)
        if not data or not IsAlive(data.Char, data.Hum) then return nil end
        local isHeadMode = (getgenv().PanteliiiConfig.AimPartMode == L.Head or getgenv().PanteliiiConfig.AimPartMode == "Голова" or getgenv().PanteliiiConfig.AimPartMode == "Head")
        local primary = isHeadMode and data.Head or data.Root
        local secondary = isHeadMode and data.Root or data.Head

        if primary and IsVisibleFast(primary, data.Char) then return primary end
        if secondary and IsVisibleFast(secondary, data.Char) then return secondary end
        return nil
    end

    local function CalculatePredictedPosition(targetPart)
        local targetPos = targetPart.Position
        local root = targetPart.Parent:FindFirstChild("HumanoidRootPart") or targetPart
        local vel = root.AssemblyLinearVelocity

        if (vel.X * vel.X + vel.Y * vel.Y + vel.Z * vel.Z) > 0.01 then
            local cfg = getgenv().PanteliiiConfig
            local predTime = cfg.ManualPrediction
            if cfg.AutoPrediction then
                local dist = (Camera.CFrame.Position - targetPos).Magnitude
                predTime = dist / math_max(cfg.BulletSpeed, 100)
            end

            return Vector3_new(
                targetPos.X + (vel.X * predTime),
                targetPos.Y + (vel.Y * predTime) + (98.1 * (predTime ^ 2)),
                targetPos.Z + (vel.Z * predTime)
            )
        end
        return targetPos
    end

