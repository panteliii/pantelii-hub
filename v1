    local function StopMovementAndRoutes()
        IsRouteRunning = false
        if RouteConnection then
            RouteConnection:Disconnect()
            RouteConnection = nil
        end

        ActiveRouteWaypoints = nil
        RouteTargetPoint = nil

        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.PlatformStand = false
                hum.AutoRotate = true
                hum.Sit = false
            end

            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                root.AssemblyLinearVelocity = Vector3_new(0, 0, 0)
                root.AssemblyAngularVelocity = Vector3_new(0, 0, 0)
            end
        end

        pcall(function()
            RayfieldMain:Notify({
                Title = "Маршруты",
                Content = "Движение остановлено!",
                Duration = 2
            })
        end)
    end

    local function RouteStep(delta)
        if not IsRouteRunning or not RouteTargetPoint then return end

        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if not root or not hum then
            StopMovementAndRoutes()
            return
        end

        hum.PlatformStand = true
        hum.AutoRotate = false

        local currentPos = root.Position
        local targetVirtual = Vector3_new(RouteTargetPoint.X, getgenv().PanteliiiConfig.FlyRouteHeight, RouteTargetPoint.Z)
        local horizontalDist = (Vector2_new(targetVirtual.X, targetVirtual.Z) - Vector2_new(currentPos.X, currentPos.Z)).Magnitude

        if horizontalDist < 2.5 then
            CurrentRouteIndex = CurrentRouteIndex + 1
            if CurrentRouteIndex > #ActiveRouteWaypoints then
                StopMovementAndRoutes()
                pcall(function()
                    RayfieldMain:Notify({
                        Title = "Маршрут",
                        Content = "Маршрут успешно завершен!",
                        Duration = 3
                    })
                end)
                return
            end
            RouteTargetPoint = ActiveRouteWaypoints[CurrentRouteIndex]
            return
        end

        local direction = (targetVirtual - currentPos).Unit
        local vel = direction * getgenv().PanteliiiConfig.FlyRouteSpeed

        local heightDiff = targetVirtual.Y - currentPos.Y
        if math.abs(heightDiff) > 1.5 then
            vel = vel + Vector3_new(0, heightDiff * 2, 0)
        end

        root.AssemblyLinearVelocity = vel
        root.CFrame = CFrame.lookAt(root.Position, root.Position + Vector3_new(direction.X, 0, direction.Z))

        if currentPos.Y < 0 then
            root.CFrame = CFrame_new(Vector3_new(currentPos.X, getgenv().PanteliiiConfig.FlyRouteHeight, currentPos.Z))
            root.AssemblyLinearVelocity = Vector3_new(0, 0, 0)
        end
    end

    local function StartAutoRoute(waypointsList, name)
        StopMovementAndRoutes()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        ActiveRouteWaypoints = waypointsList
        local closestIndex = 1
        local closestDist = math_huge

        for i, pt in ipairs(waypointsList) do
            local d = (Vector2_new(pt.X, pt.Z) - Vector2_new(root.Position.X, root.Position.Z)).Magnitude
            if d < closestDist then
                closestDist = d
                closestIndex = i
            end
        end

        CurrentRouteIndex = closestIndex
        RouteTargetPoint = ActiveRouteWaypoints[closestIndex]
        IsRouteRunning = true

        pcall(function()
            RayfieldMain:Notify({
                Title = "Маршрут: " .. name,
                Content = "Запущен с точки #" .. closestIndex,
                Duration = 3
            })
        end)

        RouteConnection = RunService.Heartbeat:Connect(RouteStep)
    end

