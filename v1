    local function ProcessFlight(delta)
        local cfg = getgenv().PanteliiiConfig
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local inVehicle = (hum and hum.Sit)

        local currentSpeed = inVehicle and cfg.FlySpeed or cfg.FlyWalkSpeed
        local targetVelocity = Vector3_new(0, 0, 0)

        if not UserInputService:GetFocusedTextBox() then
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                targetVelocity = targetVelocity + (Camera.CFrame.LookVector * currentSpeed)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                targetVelocity = targetVelocity - (Camera.CFrame.RightVector * currentSpeed)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                targetVelocity = targetVelocity - (Camera.CFrame.LookVector * currentSpeed)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                targetVelocity = targetVelocity + (Camera.CFrame.RightVector * currentSpeed)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                targetVelocity = targetVelocity + (Camera.CFrame.UpVector * currentSpeed)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
                targetVelocity = targetVelocity * cfg.SpeedKeyMultiplier
            end
        end

        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local targetPart = root:GetRootPart() or root

        if not targetPart or targetPart.Anchored or not isnetworkowner(targetPart) then return end

        if not FlyBodyVelocity or not FlyBodyVelocity.Parent then
            CreateBypassObjects(targetPart)
        end

        FlyCurrentVelocity = FlyCurrentVelocity + (targetVelocity - FlyCurrentVelocity) * math_min(1, delta * (1 / cfg.Smoothness))

        if targetVelocity.Magnitude < 0.1 then
            FlyCurrentVelocity = FlyCurrentVelocity * 0.95
        end

        FlyBodyVelocity.Velocity = FlyCurrentVelocity + Vector3_new(0, 2, 0)
        pcall(function()
            targetPart.AssemblyLinearVelocity = FlyCurrentVelocity + Vector3_new(0, 2, 0)
        end)

        local camDir = Camera.CFrame.LookVector
        local flatDir = Vector3_new(camDir.X, 0, camDir.Z)

        if flatDir.Magnitude > 0.001 then
            flatDir = flatDir.Unit
            local targetCF = CFrame.lookAt(targetPart.Position, targetPart.Position + flatDir)

            if not FlySmoothRotation then
                FlySmoothRotation = targetCF
            end

            FlySmoothRotation = FlySmoothRotation:Lerp(targetCF, math_min(1, delta * cfg.TurnSmoothness))

            if FlyBodyGyro then
                FlyBodyGyro.CFrame = FlySmoothRotation
            end

            targetPart.CFrame = CFrame_new(targetPart.Position) * FlySmoothRotation.Rotation
            targetPart.RotVelocity = Vector3_new(0, 0, 0)
        end
    end

